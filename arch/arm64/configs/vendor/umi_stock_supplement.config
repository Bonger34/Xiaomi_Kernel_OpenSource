# 补齐与原厂生产 config 的差异（MTD / netfilter action / CPU_FREQ_STAT 等）
# 由 A10 原厂内核内嵌 IKCONFIG 逐项比对得出
CONFIG_BINDER_OPT=y
CONFIG_CPU_FREQ_STAT=y
# CONFIG_FINGERPRINT_GOODIX_FOD_LMI is not set
# CONFIG_FTL is not set
# CONFIG_INFTL is not set
# CONFIG_JFFS2_FS is not set
CONFIG_KPERFEVENTS=y
CONFIG_KTRACE=y
# CONFIG_LEDS_TRIGGER_MTD is not set
CONFIG_MIGT=y
CONFIG_MIHW=y
CONFIG_MILLET=y
CONFIG_MISYSINFOFREADER=y
CONFIG_MTD=y
# CONFIG_MTD_ABSENT is not set
# CONFIG_MTD_AFS_PARTS is not set
# CONFIG_MTD_AR7_PARTS is not set
CONFIG_MTD_BLKDEVS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_BLOCK2MTD=y
# CONFIG_MTD_CFI is not set
CONFIG_MTD_CFI_I1=y
CONFIG_MTD_CFI_I2=y
# CONFIG_MTD_CMDLINE_PARTS is not set
# CONFIG_MTD_COMPLEX_MAPPINGS is not set
# CONFIG_MTD_DATAFLASH is not set
# CONFIG_MTD_DOCG3 is not set
# CONFIG_MTD_INTEL_VR_NOR is not set
# CONFIG_MTD_JEDECPROBE is not set
# CONFIG_MTD_LPDDR is not set
CONFIG_MTD_MAP_BANK_WIDTH_1=y
CONFIG_MTD_MAP_BANK_WIDTH_2=y
CONFIG_MTD_MAP_BANK_WIDTH_4=y
# CONFIG_MTD_MCHP23K256 is not set
# CONFIG_MTD_MTDRAM is not set
# CONFIG_MTD_NAND is not set
CONFIG_MTD_OF_PARTS=y
# CONFIG_MTD_ONENAND is not set
CONFIG_MTD_OOPS=y
# CONFIG_MTD_PARTITIONED_MASTER is not set
# CONFIG_MTD_PHRAM is not set
# CONFIG_MTD_PLATRAM is not set
# CONFIG_MTD_PMC551 is not set
# CONFIG_MTD_RAM is not set
# CONFIG_MTD_REDBOOT_PARTS is not set
# CONFIG_MTD_ROM is not set
# CONFIG_MTD_SLRAM is not set
# CONFIG_MTD_SPI_NAND is not set
# CONFIG_MTD_SPI_NOR is not set
# CONFIG_MTD_SST25L is not set
# CONFIG_MTD_SWAP is not set
# CONFIG_MTD_TESTS is not set
# CONFIG_MTD_UBI is not set
CONFIG_NET_ACT_CSUM=y
CONFIG_NET_ACT_NAT=y
CONFIG_NET_ACT_PEDIT=y
# CONFIG_NFTL is not set
CONFIG_PACKAGE_RUNTIME_INFO=y
# CONFIG_RFD_FTL is not set
CONFIG_RTMM=y
CONFIG_SLA_STAIC_COLLECT=y
# CONFIG_SM_FTL is not set
# CONFIG_SSFDC is not set
# CONFIG_TOUCHSCREEN_FTS is not set
CONFIG_TOUCHSCREEN_GOODIX_GTX8=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_GESTURE=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_TOOLS=y
CONFIG_TOUCHSCREEN_GOODIX_GTX8_UPDATE=y
# CONFIG_TOUCHSCREEN_GOODIX_REGULATOR is not set
